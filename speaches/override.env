# This file can be used for additional
# environment variable overrides that will
# only be visible to the speaches service.
#
# Optimized Speaches Configuration
# File: override.env
#
# Based on analysis of config.py and benchmark results

# ============================================
# BASIC SETTINGS
# ============================================

LOOPBACK_HOST_URL=http://localhost:8000
ALLOW_ORIGINS='["*"]'
LOG_LEVEL=info # Reduce from debug for production

# ============================================
# MODEL LIFECYCLE - Keep models warm
# ============================================

# Never unload models (-1 = permanent)
STT_MODEL_TTL=-1
TTS_MODEL_TTL=-1

# Preload your primary models at startup
# Eliminates first-request model loading penalty
PRELOAD_MODELS='["deepdml/faster-whisper-large-v3-turbo-ct2", "k1nto/Belle-whisper-large-v3-zh-punct-ct2", "speaches-ai/Kokoro-82M-v1.0-ONNX"]'

# ============================================
# WHISPER CONFIGURATION
# Use double underscore (__) for nested settings
# ============================================

# Force CUDA (your RTX 3090)
WHISPER__INFERENCE_DEVICE=cuda

# Compute type options:
#   float32  - Highest accuracy, slowest, most VRAM
#   float16  - Good balance (recommended for RTX 3090)
#   int8_float16 - Faster, slightly lower accuracy
#   int8     - Fastest, lowest accuracy
WHISPER__COMPUTE_TYPE=float16

# Device index (0 = first GPU)
WHISPER__DEVICE_INDEX=0

# Number of parallel workers (try 2-4 for concurrent requests)
WHISPER__NUM_WORKERS=2

# CPU threads (0 = auto, only matters if using CPU)
WHISPER__CPU_THREADS=0

# ============================================
# ONNX RUNTIME OPTIONS (for Parakeet/Kokoro)
# ============================================

# Exclude TensorRT (causes issues, already default)
# UNSTABLE_ORT_OPTS__EXCLUDE_PROVIDERS='["TensorrtExecutionProvider"]'

# Ensure CUDA has highest priority
UNSTABLE_ORT_OPTS__PROVIDER_PRIORITY='{"CUDAExecutionProvider": 100, "CPUExecutionProvider": 0}'

# CUDA provider options (optional tuning)
UNSTABLE_ORT_OPTS__PROVIDER_OPTS='{"CUDAExecutionProvider": {"cudnn_conv_algo_search": "EXHAUSTIVE", "do_copy_in_default_stream": true}}'

# ============================================
# VAD FILTER - CANNOT BE DISABLED VIA ENV
# ============================================

# NOTE: This DOES NOT WORK due to underscore prefix in source code
# The field is: _unstable_vad_filter (private field)
# Pydantic won't read private fields from environment variables
#
# To fix, you need to either:
# 1. Patch speaches/config.py: change "_unstable_vad_filter" to "unstable_vad_filter"
# 2. Pass vad_filter=false in API request body (if supported)
# 3. Submit PR to speaches-ai repo
#
#_UNSTABLE_VAD_FILTER=false  # This line does nothing!
#UNSTABLE_VAD_FILTER=false   # This also doesn't work

# ============================================
# UI SETTINGS
# ============================================

ENABLE_UI=False 
GRADIO_MCP_SERVER=False
